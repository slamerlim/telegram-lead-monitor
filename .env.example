API_PORT=8010
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=telegram_leads
POSTGRES_USER=telegram_leads
POSTGRES_PASSWORD=change-me

REDIS_URL=redis://redis:6379/0

TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=replace-me
TELEGRAM_PHONE=+10000000000
TELEGRAM_SESSION_PATH=/data/telegram/telegram_lead_monitor.session

COLLECTOR_CONCURRENCY=3
COLLECTOR_BATCH_SIZE=200
COLLECTOR_FLOOD_WAIT_BUFFER_SECONDS=5
SCAN_DEFAULT_DAYS=30
SCHEDULER_INTERVAL_SECONDS=900
SCHEDULER_SCAN_DAYS=2

SEMANTIC_ENABLED=false
SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_THRESHOLD=0.48

SCORING_CONFIG=/app/config/scoring.yaml

# Independent human review (all three required or queue/POST return 503)
INDEPENDENT_HUMAN_REVIEWER_IDS=
INDEPENDENT_HUMAN_REVIEWER_TOKENS=
INDEPENDENT_REVIEW_HMAC_SECRET=
# M1/positive gates (both required): labeled_by allowlist + POST /labels write token
HUMAN_LABEL_REVIEWER_IDS=
LABEL_WRITE_TOKEN=
# When true, block /search /leads /docs etc. during human blind-review sessions
REVIEW_UI_LOCKDOWN=false

# Cursor-only AI validation (no OpenAI/Anthropic keys). Prefer .env.validation for secrets.
AI_VALIDATORS_CONFIG=/app/config/ai_validators.yaml
AI_VALIDATOR_IDS=
AI_VALIDATOR_TOKENS=
AI_VALIDATION_QUEUE_HMAC_SECRET=
AI_VALIDATION_ROW_SECRET=
AI_VALIDATION_REQUIRE_DISTINCT_FAMILIES=true
AI_VALIDATION_GATE_MIN_MESSAGES=100
AI_VALIDATION_GATE_MIN_TRUE=30
# Orchestrator only (never commit the real key):
CURSOR_API_KEY=
API_BASE_URL=http://127.0.0.1:8010

