from __future__ import annotations

import re
from dataclasses import dataclass
from decimal import Decimal, InvalidOperation
from pathlib import Path

import yaml


@dataclass
class ScoreResult:
    score: float
    tier: str
    buyer_type: str
    lead_type: str
    intent_score: float
    technical_score: float
    commercial_score: float
    promotion_score: float
    matched_keywords: list[str]
    matched_categories: list[str]
    reasons: list[str]
    contact_usernames: list[str]
    contact_urls: list[str]
    budget_amount: float | None = None
    budget_currency: str | None = None
    semantic_score: float | None = None


class LeadScorer:
    """Deterministic commercial-intent scorer for trading-development prospects.

    The important distinction is BUYER vs NON-BUYER. Technical relevance alone does not
    make a message a commercial lead. Direct requests, concrete bot/API problems, and
    custom-build language are rewarded; service ads, job seekers, and generic product
    support questions are suppressed.
    """

    _username_rx = re.compile(r"(?<![\w@])@([A-Za-z0-9_]{4,32})")
    _http_rx = re.compile(r"https?://\S+", re.IGNORECASE)
    _money_patterns = [
        re.compile(r"(?P<cur>\$|€|₽)\s*(?P<num>\d+(?:[.,]\d+)?\s*[kKmM]?)"),
        re.compile(
            r"(?P<num>\d+(?:[.,]\d+)?\s*[kKmM]?)\s*"
            r"(?P<cur>USD|USDT|USDC|EUR|RUB|\$|€|₽)\b",
            re.IGNORECASE,
        ),
        re.compile(
            r"(?P<num>\d+(?:[.,]\d+)?\s*[kKmM]?)\s*"
            r"(?P<cur>dollars?|euros?|руб(?:лей|\.)|доллар(?:ов|а)?)",
            re.IGNORECASE,
        ),
    ]
    _multiplier = {"k": 1_000.0, "m": 1_000_000.0}
    _currency_map = {
        "$": "USD",
        "usd": "USD",
        "usdt": "USDT",
        "usdc": "USDC",
        "eur": "EUR",
        "€": "EUR",
        "rub": "RUB",
        "₽": "RUB",
        "руб": "RUB",
        "рублей": "RUB",
        "доллар": "USD",
        "долларов": "USD",
        "dollar": "USD",
        "dollars": "USD",
        "euro": "EUR",
        "euros": "EUR",
    }

    def __init__(self, path: str, high: float = 75, medium: float = 50) -> None:
        data = yaml.safe_load(Path(path).read_text(encoding="utf-8")) or {}
        self.thresholds = data.get("thresholds", {})
        self.weights: dict[str, float] = data.get("categories", {})
        self.terms: dict[str, list[str]] = data.get("terms", {})
        self.patterns: dict[str, list[re.Pattern[str]]] = {
            key: [re.compile(pattern, re.IGNORECASE | re.UNICODE) for pattern in values]
            for key, values in data.get("patterns", {}).items()
        }
        self.high = float(self.thresholds.get("high", high))
        self.medium = float(self.thresholds.get("medium", medium))
        self.compiled = {
            category: [
                (
                    term,
                    re.compile(
                        rf"(?<!\w){re.escape(term)}(?!\w)",
                        re.IGNORECASE | re.UNICODE,
                    ),
                )
                for term in terms
            ]
            for category, terms in self.terms.items()
        }

    def _matches(self, text: str) -> tuple[list[str], list[str], dict[str, list[str]]]:
        matched_keywords: list[str] = []
        categories: list[str] = []
        by_category: dict[str, list[str]] = {}
        for category, pairs in self.compiled.items():
            matches = [term for term, rx in pairs if rx.search(text)]
            if matches:
                matched_keywords.extend(matches)
                categories.append(category)
                by_category[category] = matches
        return list(dict.fromkeys(matched_keywords)), list(dict.fromkeys(categories)), by_category

    def _pattern_hits(self, text: str, category: str) -> list[str]:
        return [pattern.pattern for pattern in self.patterns.get(category, []) if pattern.search(text)]

    def _classify_buyer(self, text: str, categories: list[str]) -> tuple[str, list[str]]:
        provider_hits = self._pattern_hits(text, "service_provider")
        seeker_hits = self._pattern_hits(text, "job_seeker")
        recruiter_hits = self._pattern_hits(text, "recruiter")
        buyer_hits = self._pattern_hits(text, "buyer_intent")
        technical_hits = self._pattern_hits(text, "technical_problem")
        support_hits = self._pattern_hits(text, "platform_support")
        reasons: list[str] = []

        # Explicit self-promotion/job-seeker language wins unless the same message also
        # contains a concrete first-person buyer request.
        if seeker_hits and not buyer_hits:
            reasons.append("job-seeker/CV language detected")
            return "JOB_SEEKER", reasons
        if provider_hits and not buyer_hits:
            reasons.append("service-provider language detected")
            return "SERVICE_PROVIDER", reasons

        if recruiter_hits and not buyer_hits and not technical_hits:
            reasons.append("recruiter/hiring language detected")
            return "RECRUITER", reasons

        if buyer_hits and not support_hits:
            reasons.append(f"buyer-intent language: {", ".join(buyer_hits[:3])}")
            return "CLIENT", reasons
        if buyer_hits and support_hits:
            reasons.append("generic platform/account-support request detected; not treated as a development buyer")

        # A concrete first-person system failure is buyer-like even if the word "developer"
        # is absent. It indicates an existing system and an actionable problem.
        lower = text.lower()
        existing_system_signal = any(token in lower for token in (
            "my bot", "our bot", "my trading", "our trading", "my api", "our api",
            "my account", "my system", "my strategy", "у меня", "мой бот", "наш бот",
            "live spot account", "live account", "using pybit", "using ccxt", "using api v5",
            "i tried", "i already tried", "already attempted", "multiple fixes", "already confirmed",
        ))
        if technical_hits and existing_system_signal and not support_hits:
            reasons.append("first-person technical problem on an existing system")
            return "CLIENT", reasons

        return "UNKNOWN", reasons

    def _classify_lead_type(self, text: str, categories: list[str], buyer_type: str) -> str:
        lower = text.lower()
        if buyer_type == "SERVICE_PROVIDER":
            return "SERVICE_ADVERTISEMENT"
        if buyer_type == "JOB_SEEKER":
            return "JOB_SEEKER"
        if buyer_type == "RECRUITER":
            return "JOB_VACANCY"

        technical = bool(self._pattern_hits(text, "technical_problem"))
        support = bool(self._pattern_hits(text, "platform_support"))
        bot = "trading_bot" in categories
        api = "exchange_api" in categories
        execution = "execution" in categories

        if buyer_type == "CLIENT" and technical and bot:
            return "BOT_REPAIR"
        if buyer_type == "CLIENT" and "strategy_automation" in categories and self._pattern_hits(text, "buyer_intent"):
            return "BOT_CUSTOMIZATION"
        if buyer_type == "CLIENT" and technical and (api or execution):
            return "EXECUTION_PROBLEM"
        if buyer_type == "CLIENT" and "arbitrage" in categories:
            return "ARBITRAGE_PROJECT"
        if buyer_type == "CLIENT" and "copy_trading" in categories:
            return "COPY_TRADING_PROJECT"
        if buyer_type == "CLIENT" and "solana_dex" in categories:
            return "SOLANA_DEX_PROJECT"
        if buyer_type == "CLIENT" and "quant_ml" in categories:
            return "QUANT_ML_PROJECT"
        if buyer_type == "CLIENT" and (bot or api or execution):
            return "TRADING_SYSTEM_BUILD"
        if support and buyer_type != "CLIENT":
            return "TECHNICAL_QUESTION"
        if technical:
            return "TECHNICAL_PROBLEM"
        if any(token in lower for token in ("freelance project", "gig of the day", "top-paying projects")):
            return "FREELANCE_PROJECT"
        return "TECHNICAL_QUESTION" if categories else "NOISE"

    def _extract_contacts(self, text: str) -> tuple[list[str], list[str]]:
        usernames: list[str] = []
        for username in self._username_rx.findall(text):
            lowered = username.lower()
            if lowered in {"username", "channelname", "example", "everyone", "here"}:
                continue
            usernames.append(username)
        usernames = list(dict.fromkeys(usernames))
        return usernames, [f"https://t.me/{u}" for u in usernames]

    def _extract_budget(self, text: str) -> tuple[float | None, str | None]:
        for rx in self._money_patterns:
            match = rx.search(text)
            if not match:
                continue
            raw_num = re.sub(r"\s+", "", match.group("num")).replace(",", ".")
            suffix = raw_num[-1].lower() if raw_num and raw_num[-1].lower() in self._multiplier else ""
            if suffix:
                raw_num = raw_num[:-1]
            try:
                amount = float(Decimal(raw_num)) * self._multiplier.get(suffix, 1.0)
            except (InvalidOperation, ValueError):
                continue
            raw_cur = match.group("cur").lower()
            return amount, self._currency_map.get(raw_cur, raw_cur.upper())
        return None, None

    def score(self, text: str) -> ScoreResult:
        clean = " ".join(text.split())
        matched_keywords, categories, by_category = self._matches(clean)

        # Promote high-confidence technical patterns into their semantic categories.
        # This catches messages that describe an API failure/error code without literally
        # containing phrases such as "exchange api".
        technical_hits = self._pattern_hits(clean, "technical_problem")
        lower_clean = clean.lower()
        if technical_hits and any(token in lower_clean for token in (
            "api", "pybit", "/v5/", "websocket", "order", "errcode", "error code",
        )):
            if "exchange_api" not in categories and any(token in lower_clean for token in (
                "api", "pybit", "/v5/", "websocket", "errcode", "error code",
            )):
                categories.append("exchange_api")
                by_category["exchange_api"] = ["technical API problem"]
                if "exchange_api" not in matched_keywords:
                    matched_keywords.append("technical API problem")
        if technical_hits and any(token in lower_clean for token in (
            "bot", "trading bot", "торговый бот", "торгового бота",
        )):
            if "trading_bot" not in categories:
                categories.append("trading_bot")
                by_category["trading_bot"] = ["existing bot problem"]
                matched_keywords.append("existing bot problem")
        buyer_type, buyer_reasons = self._classify_buyer(clean, categories)
        lead_type = self._classify_lead_type(clean, categories, buyer_type)
        contacts, contact_urls = self._extract_contacts(clean)
        budget_amount, budget_currency = self._extract_budget(clean)

        reasons = list(buyer_reasons)
        score = 0.0
        intent_score = 0.0
        technical_score = 0.0
        commercial_score = 0.0
        promotion_score = 0.0

        technical_categories = {
            "trading_bot", "exchange_api", "execution", "strategy_automation",
            "arbitrage", "copy_trading", "solana_dex", "quant_ml", "python",
        }

        for category in categories:
            weight = float(self.weights.get(category, 0.0))
            if category == "negative_promotion":
                promotion_score += weight
                score += weight
                reasons.append(f"promotion penalty: {', '.join(by_category[category][:3])}")
                continue
            score += weight
            if category in technical_categories:
                technical_score += max(0.0, weight)
            reasons.append(f"{category}: {', '.join(by_category[category][:4])}")

        # Intent is based on actual buyer evidence, not on the existence of a generic client
        # label. This fixes the previous 0.0 intent_score problem.
        buyer_hits = self._pattern_hits(clean, "buyer_intent")
        support_hits = self._pattern_hits(clean, "platform_support")
        if buyer_hits and not support_hits:
            intent_score += 30
            commercial_score += 30
            score += 30
            reasons.append("explicit commercial/buyer intent detected")
        elif buyer_type == "CLIENT":
            intent_score += 18
            commercial_score += 18
            score += 18
            reasons.append("client-like intent from concrete existing-system problem")

        if buyer_type == "RECRUITER":
            commercial_score += 5
            score += 5
        elif buyer_type in {"SERVICE_PROVIDER", "JOB_SEEKER"}:
            promotion_score -= 45
            score -= 45
            reasons.append("non-buyer message suppressed")

        if lead_type in {"BOT_REPAIR", "EXECUTION_PROBLEM"}:
            commercial_score += 20
            score += 20
            reasons.append("concrete existing-system problem creates strong purchase intent")

        if lead_type == "BOT_CUSTOMIZATION":
            commercial_score += 20
            score += 20
            reasons.append("explicit request to customize/modify trading automation")

        if buyer_type == "CLIENT" and any(c in categories for c in technical_categories):
            commercial_score += 10
            score += 10
            reasons.append("client intent paired with technical trading requirement")

        if buyer_type == "CLIENT" and "trading_bot" in categories and buyer_hits:
            score += 8
            commercial_score += 8
            reasons.append("explicit buyer intent paired with trading-bot context")

        if len([c for c in categories if c != "negative_promotion"]) >= 3:
            score += 5
            reasons.append("multiple independent trading-development signals")

        if budget_amount is not None:
            score += 12
            commercial_score += 12
            reasons.append(f"explicit budget: {budget_amount:g} {budget_currency}")
        elif buyer_type in {"CLIENT", "RECRUITER"} and self._pattern_hits(clean, "budget_context"):
            # Context words are useful only when we already know this is a commercial actor.
            score += 2
            commercial_score += 2
            reasons.append("budget/compensation context detected without a numeric amount")

        if "urgency" in categories:
            score += 8
            commercial_score += 8

        if len(self._http_rx.findall(clean)) >= 3:
            score -= 8
            promotion_score -= 8
            reasons.append("link-heavy message")

        # Strong negative classes cannot become high-value leads from technical keywords alone.
        if buyer_type in {"SERVICE_PROVIDER", "JOB_SEEKER"}:
            score = min(score, 20.0)

        # Recruiter vacancies remain visible but are capped below direct-client leads.
        if buyer_type == "RECRUITER":
            score = min(score, 69.0)
        if support_hits and buyer_type != "CLIENT":
            score = min(score, 35.0)

        score = max(0.0, min(100.0, score))
        tier = "HIGH" if score >= self.high else "MEDIUM" if score >= self.medium else "LOW"
        if lead_type in {"SERVICE_ADVERTISEMENT", "JOB_SEEKER", "NOISE"}:
            tier = "LOW"

        return ScoreResult(
            score=score,
            tier=tier,
            buyer_type=buyer_type,
            lead_type=lead_type,
            intent_score=round(intent_score, 2),
            technical_score=round(technical_score, 2),
            commercial_score=round(commercial_score, 2),
            promotion_score=round(promotion_score, 2),
            matched_keywords=list(dict.fromkeys(matched_keywords)),
            matched_categories=list(dict.fromkeys(categories)),
            reasons=list(dict.fromkeys(reasons)),
            contact_usernames=contacts,
            contact_urls=contact_urls,
            budget_amount=budget_amount,
            budget_currency=budget_currency,
        )
