patterns:
  # Only phrases that indicate a concrete request for a person, implementation or repair.
  # Do not use a broad "I need ... trading" regex: it falsely matches support questions.
  buyer_intent:
    - '\b(?:i|we)\s+(?:need|want|am looking for|are looking for)\s+(?:a\s+|an\s+|somebody\s+|someone\s+)?(?:developer|programmer|engineer|coder|freelancer)\b'
    - '\b(?:i|we)\s+(?:need|want)\s+(?:someone|a\s+developer|a\s+programmer|help|assistance)\b.{0,80}\b(?:trading|bot|api|automation|strategy|exchange|quant)\b'
    - '\b(?:need|want|looking for)\b.{0,100}\b(?:fix|repair|debug|modify|customi[sz]e|build|develop|create)\b.{0,100}\b(?:bot|trading|api|strategy|exchange)\b'
    - '\b(?:looking for|need|want)\s+(?:someone|a\s+developer|a\s+programmer)\b.{0,120}\b(?:fix|repair|debug|modify|customi[sz]e|build|develop|create)\b'
    - '\b(?:my|our)\b.{0,120}\b(?:bot|trading\s+bot)\b.{0,120}\b(?:error|issue|bug|broken|fails|failed|not working|doesn\x27t work|problem|reject(?:ed|s|ing)?)\b'
    - '\b(?:who\s+can|can\s+someone|is\s+there\s+someone)\b.{0,100}\b(?:build|fix|repair|debug|modify|develop|create)\b.{0,100}\b(?:bot|trading|api|strategy|exchange)\b'
    - '\b(?:кто-нибудь|кто\s+может)\b.{0,100}\b(?:починить|сделать|доработать|разработать|исправить)\b'
    - '\b(?:мой|наш|у\s+меня|у\s+нас)\b.{0,120}\b(?:бот|торгов(?:ый|ого)\s+бот)\b.{0,120}\b(?:ошибк\w*|проблем\w*|не\s+работ\w*|слом\w*)\b'
    - '\b(?:нужен|ищу)\s+(?:разработчик|программист|человек|фрилансер)\b.{0,100}\b(?:бот|трейдинг|api|стратег|арбитраж|копитрейдинг|бирж)\b'

  service_provider:
    - '\b(?:i|we)\s+(?:can|will)\s+(?:build|develop|fix|create|help)\b'
    - '\b(?:i|we)\s+(?:develop|build|offer|provide)\b.*\b(?:bot|trading|web3|solana|crypto)\b'
    - '\bfeel\s+free\s+to\s+dm\s+me\b'
    - '\bdm\s+me\s+for\s+(?:your|a)\s+project\b'
    - '\bhire\s+me\b'
    - '\bavailable\s+for\s+(?:work|projects|hire)\b'
    - '\bя\s+могу\s+(?:сделать|разработать|починить|помочь)\b'
    - '\bобращайтесь\s+в\s+личку\b'
    - '\bпишите\s+в\s+лс\b'

  job_seeker:
    - '#(?:ищу_работу|open_to_work|looking_for_work)'
    - '\blooking\s+for\s+(?:work|a\s+job|a\s+position)\b'
    - '\b(?:cv|resume)\b'
    - '\bavailability\s*:\s*(?:remote|full-time|part-time|contract)\b'
    - '\bищу\s+работу\b'
    - '\bрезюме\b'
    - '\bготов\s+к\s+работе\b'

  recruiter:
    - '#(?:vacancy|hiring|job)'
    - '\bwe\s+are\s+hiring\b'
    - '\b(?:vacancy|position)\b.*\b(?:developer|engineer|trader|quant)\b'
    - '\bтребуется\b.*\b(?:разработчик|программист|инженер|квант)\b'
    - '\bищем\b.*\b(?:разработчика|программиста|инженера|разработчика)\b'

  platform_support:
    - '\b(?:reactivat|suspend|appeal|verify|kyc|withdraw|deposit|transfer funds|account restricted|account locked)\w*\b'
    - '\b(?:help me|please help|can you help)\b.{0,60}\b(?:account|subaccount|uid|verification|suspension|withdraw|deposit)\b'
    - '\b(?:check my account|reactivate my account|unblock my account)\b'
    - '\b(?:помогите|помоги)\b.{0,80}\b(?:аккаунт|субаккаунт|верификац|блокиров|вывод|пополн)\w*\b'

  technical_problem:
    - '\b(?:bug|error|issue|problem|broken|fails|failed|not working|doesn\x27t work|reject(?:ed|s|ing)?|exception)\b'
    - '\b(?:errcode|error code|stack trace|traceback|api\s+returns|returns\s+(?:an?\s+)?error)\b'
    - '\b(?:ошибк\w*|проблем\w*|не\s+работает|слом\w*|отклон\w*|исключен\w*)\b'
    - '\bwhy\s+(?:is|does|are)\b'
    - '\bкак\s+исправить\b'
    - '\b(?:почему|из-за\s+чего)\b.{0,100}\b(?:ошибка|проблем|не\s+работ|отклон)\w*\b'

