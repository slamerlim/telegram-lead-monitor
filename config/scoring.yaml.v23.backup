version: 2.3

# Commercial objective of the system:
# 1) buy/commission a trading bot
# 2) fix/repair an existing trading bot
# 3) hire a trading-system developer on contract/project basis
# 4) hire a quantitative engineer on contract/project basis
# 5) hire an ML/AI engineer on contract/project basis
# 6) implement/automate a trading strategy
#
# Technical relevance is NOT commercial intent. A technical/support question must not become a lead.

thresholds:
  high: 75
  medium: 50

categories:
  trading_bot: 18
  exchange_api: 12
  execution: 16
  strategy_automation: 16
  arbitrage: 18
  copy_trading: 16
  solana_dex: 16
  quant_ml: 18
  market_making: 18
  python: 5
  urgency: 5

terms:
  trading_bot:
    - trading bot
    - crypto bot
    - bybit bot
    - binance bot
    - bitget bot
    - okx bot
    - telegram trading bot
    - trading bot developer
    - grid bot
    - dca bot
    - scalping bot
    - sniper bot
    - token sniper
    - торговый бот
    - торгового бота
    - бот для bybit
    - бот для binance
    - бот для bitget
    - бот для okx
    - бот для фьючерсов
    - арбитражный бот
    - бот для копитрейдинга

  exchange_api:
    - exchange api
    - api trading
    - binance api
    - bybit api
    - bitget api
    - okx api
    - python developer binance api
    - python developer bybit api
    - rest api
    - websocket
    - pybit
    - ccxt
    - API v5
    - api биржи
    - торговый api

  execution:
    - order execution
    - execution engine
    - trading execution
    - execution system
    - partial fill
    - partial fills
    - order management
    - order rejected
    - order rejection
    - slippage
    - latency
    - order book
    - исполнение ордеров
    - частичное исполнение
    - система исполнения
    - ордер отклонен

  strategy_automation:
    - grid bot
    - dca bot
    - scalping bot
    - automated trading
    - automation of my strategy
    - automate my strategy
    - strategy automation
    - implement my strategy
    - implement this strategy
    - automate this strategy
    - автоматизация торговли
    - автоматизировать стратегию
    - реализовать стратегию
    - внедрить стратегию

  arbitrage:
    - arbitrage bot
    - funding arbitrage
    - cross exchange arbitrage
    - basis trading
    - funding rate arbitrage
    - арбитражный бот
    - арбитраж между биржами
    - фандинг арбитраж

  copy_trading:
    - copy trading
    - copy-trading bot
    - wallet copy trading
    - trade copier
    - telegram copy trading
    - copy trades
    - копитрейдинг
    - копирование сделок
    - бот для копитрейдинга

  solana_dex:
    - solana trading bot
    - solana bot
    - dex bot
    - sniper bot
    - token sniper
    - jupiter bot
    - raydium bot
    - jito bot
    - mev bot
    - jupiter
    - raydium
    - jito
    - dex
    - solana

  quant_ml:
    - ai trading bot
    - ml trading bot
    - quant trading
    - quant developer
    - quant engineer
    - quantitative developer
    - quantitative engineer
    - quant researcher
    - machine learning trading
    - machine learning engineer
    - ml engineer
    - ai engineer
    - artificial intelligence engineer
    - signal filtering
    - trading infrastructure
    - execution infrastructure
    - algorithmic trading
    - algorithmic trading developer
    - алготрейдинг
    - квант
    - квантовый разработчик
    - quantitative developer
    - машинное обучение
    - разработчик ml
    - ai разработчик

  market_making:
    - market maker
    - market making
    - market making bot
    - liquidity provision
    - ликвидность
    - маркет-мейкинг
    - маркет мейкер

  python:
    - python
    - python developer
    - pybit
    - ccxt

  urgency:
    - urgent
    - asap
    - immediately
    - urgently
    - срочно
    - как можно скорее

patterns:
  # Explicit COMMERCIAL actions. These are the gate for a commercial lead.
  commercial_purchase:
    - '\b(?:i|we)\s+(?:want|would like|am looking|are looking)\s+to\s+(?:buy|purchase)\b.{0,120}\b(?:bot|trading|software|system|automation)\b'
    - '\b(?:looking to buy|looking to purchase|want to buy|need to buy|need to purchase)\b.{0,100}\b(?:bot|trading|software|system)\b'
    - '\b(?:купить|хочу купить|ищу где купить|нужен)\b.{0,100}\b(?:бот|торгов(?:ый|ая)|система|автоматизац)\w*\b'

  commercial_repair:
    - '\b(?:need|looking for|want|hiring|hire)\b.{0,160}\b(?:developer|programmer|engineer|freelancer|someone|help)\b.{0,160}\b(?:fix|repair|debug|troubleshoot)\b.{0,160}\b(?:bot|trading|api|strategy|system|execution)\b'
    - '\b(?:my|our)\b.{0,120}\b(?:bot|trading\s+bot|trading\s+system)\b.{0,120}\b(?:broken|bug|error|issue|problem|fails|failed|not working|doesn\x27t work|stopped)\b.{0,120}\b(?:developer|programmer|engineer|freelancer|someone|help|fix|repair|debug)\b'
    - '\b(?:who\s+can|can\s+someone|is\s+there\s+someone)\b.{0,120}\b(?:fix|repair|debug|troubleshoot)\b.{0,120}\b(?:my|our)?\s*(?:trading\s+)?bot\b'
    - '\b(?:нужен|ищу)\s+(?:разработчик|программист|инженер|фрилансер|человек)\b.{0,120}\b(?:починить|исправить|дебаг|доработать|бот|трейдинг|систем)\w*\b'
    - '\b(?:мой|наш|у\s+меня|у\s+нас)\b.{0,120}\b(?:бот|торгов(?:ый|ого)\s+бот)\b.{0,120}\b(?:слом\w*|ошибк\w*|проблем\w*|не\s+работ\w*)\b.{0,120}\b(?:разработчик|программист|инженер|починить|исправить|помогите|помочь)\b'

  commercial_customization:
    - '\b(?:need|looking for|want)\b.{0,100}\b(?:developer|programmer|engineer|freelancer|someone)\b.{0,100}\b(?:customi[sz]e|modify|extend|add)\b.{0,120}\b(?:bot|trading|dca|grid|strategy|system)\b'
    - '\b(?:my|our)\b.{0,100}\b(?:bot|dca bot|grid bot|trading system)\b.{0,100}\b(?:customi[sz]e|modify|extend|add|change)\b'
    - '\b(?:нужен|ищу)\s+(?:разработчик|программист|инженер|фрилансер)\b.{0,100}\b(?:доработать|модифицировать|добавить|изменить)\b.{0,100}\b(?:бот|стратег|трейдинг)\w*\b'
    - '\b(?:мой|наш)\b.{0,100}\b(?:бот|торгов(?:ый|ая)\s+систем)\w*\b.{0,100}\b(?:доработать|изменить|добавить|кастомиз)\w*\b'

  commercial_hire:
    - '\b(?:hire|hiring|looking for|seeking|need|want)\b.{0,120}\b(?:developer|engineer|programmer|quant|quantitative|ml engineer|ai engineer|machine learning|freelancer|contractor)\b'
    - '\b(?:on|for a)\s+(?:contract|contractor|freelance|project|fixed[- ]term)\b'
    - '\b(?:contract|contractor|freelance|freelancer|project[- ]based|fixed[- ]term|part[- ]time)\b.{0,100}\b(?:developer|engineer|quant|ml|ai|programmer)\b'
    - '\b(?:нанять|ищем|нужен|ищу)\b.{0,100}\b(?:разработчик|программист|инженер|квант|ml|ai)\b.{0,100}\b(?:контракт|фриланс|проект|подряд)\w*\b'

  commercial_implementation:
    - '\b(?:need|looking for|want|hiring|hire)\b.{0,140}\b(?:developer|programmer|engineer|freelancer|someone)\b.{0,140}\b(?:implement|automate|build)\b.{0,160}\b(?:strategy|algorithm|trading strategy|system|trading bot|futures trading)\b'
    - '\b(?:i|we)\s+(?:have|created|developed)\s+(?:a\s+)?(?:trading\s+)?strategy\b.{0,200}\b(?:need|looking for|want|hiring)\b.{0,140}\b(?:implement|automate|developer|programmer|engineer)\b'
    - '\b(?:реализовать|внедрить|автоматизировать)\b.{0,100}\b(?:стратеги|торгов|алгоритм)\w*\b.{0,100}\b(?:разработчик|программист|инженер|подрядчик)\b'

  buyer_intent:
    - '\b(?:need|looking for|seeking|want|hire|hiring|commission|purchase|buy|quote|budget|proposal)\b.{0,180}\b(?:developer|engineer|programmer|freelancer|contractor|bot|trading|strategy|quant|ml|ai|system)\b'
    - '\b(?:нужен|ищу|нанять|заказать|купить|бюджет|стоимость|цена|предложение|подрядчик)\b.{0,180}\b(?:разработчик|программист|инженер|бот|трейдинг|стратег|квант|ml|ai|систем)\w*\b'

  contract_engagement:
    - '\bcontract\b'
    - '\bcontractor\b'
    - '\bfreelance\b'
    - '\bfreelancer\b'
    - '\bproject[- ]based\b'
    - '\bfixed[- ]term\b'
    - '\bpart[- ]time\b'
    - '\bconsulting\b'
    - '\bподряд\w*\b'
    - '\bконтракт\w*\b'
    - '\bфриланс\w*\b'
    - '\bпроектн\w*\b'

  service_provider:
    - '\b(?:i|we)\s+(?:can|will)\s+(?:build|develop|fix|create|help|provide|offer)\b'
    - '\b(?:i|we)\s+(?:develop|build|offer|provide)\b.{0,120}\b(?:bot|trading|web3|solana|crypto)\b'
    - '\bfeel\s+free\s+to\s+dm\s+me\b'
    - '\bdm\s+me\s+for\s+(?:your|a)\s+project\b'
    - '\bhire\s+me\b'
    - '\bavailable\s+for\s+(?:work|projects|hire)\b'
    - '\byour\s+project\b.{0,40}\b(?:dm|message)\b'
    - '\bя\s+могу\s+(?:сделать|разработать|починить|помочь)\b'
    - '\bобращайтесь\s+в\s+(?:личку|лс)\b'
    - '\bпишите\s+в\s+(?:личку|лс)\b'

  job_seeker:
    - '#(?:ищу_работу|open_to_work|looking_for_work)'
    - '\blooking\s+for\s+(?:work|a\s+job|a\s+position)\b'
    - '\b(?:cv|resume)\b'
    - '\bavailability\s*:\s*(?:remote|full-time|part-time|contract)\b'
    - '\bищу\s+работу\b'
    - '\bрезюме\b'
    - '\bготов\s+к\s+работе\b'
    - '\bopen\s+to\s+(?:work|opportunities|new\s+roles)\b'

  recruiter:
    - '#(?:vacancy|hiring|job)'
    - '\b(?:we\s+are\s+)?hiring\b'
    - '\b(?:vacancy|position)\b.{0,100}\b(?:developer|engineer|trader|quant|programmer|ml|ai)\b'
    - '\b(?:looking\s+for|seeking)\b.{0,100}\b(?:developer|engineer|trader|quant|programmer|ml|ai)\b'
    - '\bтребуется\b.{0,100}\b(?:разработчик|программист|инженер|квант|ml|ai)\b'
    - '\bищем\b.{0,100}\b(?:разработчика|программиста|инженера|кванта|ml|ai)\b'

  platform_support:
    - '\b(?:support|api\s+team|bybit\s+team|binance\s+team|okx\s+team|please\s+clarify|please\s+check|anyone\s+know|does\s+anyone\s+know|is\s+there\s+a\s+guide|documentation)\b'
    - '\b(?:reactivat|suspend|appeal|verify|kyc|withdraw|deposit|transfer\s+funds|account\s+restricted|account\s+locked|permission\s+denied)\w*\b'
    - '\b(?:help\s+me|please\s+help|can\s+you\s+help)\b.{0,80}\b(?:account|subaccount|uid|verification|suspension|withdraw|deposit|api\s+key|permission)\b'
    - '\b(?:check\s+my\s+account|reactivate\s+my\s+account|unblock\s+my\s+account)\b'
    - '\b(?:помогите|помоги)\b.{0,100}\b(?:аккаунт|субаккаунт|верификац|блокиров|вывод|пополн|ключ|разрешен)\w*\b'
    - '\b(?:как\s+настроить|есть\s+ли\s+гайд|где\s+документация|почему\s+биржа|почему\s+bybit|почему\s+binance|пожалуйста\s+уточните)\b'

  vendor_response:
    - '\b(?:kindly|please)\s+(?:make\s+sure|check|refer\s+to)\b'
    - '\b(?:according\s+to\s+our|our\s+documentation|our\s+support|api\s+team\s+confirmed)\b'
    - '\b(?:please\s+check\s+your\s+api\s+key\s+permissions|permission\s+denied)\b'
    - '\b(?:наша\s+документация|служба\s+поддержки|проверьте\s+права|проверьте\s+api\s+ключ)\b'

  product_feedback:
    - '\b(?:is\s+there\s+a\s+guide|why\s+is\s+there\s+a\s+limit|can\s+we\s+get\s+a\s+filter|feature\s+request|please\s+add|would\s+like\s+to\s+see)\b'
    - '\b(?:limit\s+of\s+\d+\s+pairs|multi[- ]pair|watchlist|indicator\s+list|safety\s+orders)\b'
    - '\b(?:добавьте\s+фильтр|ограничение\s+пар|хочу\s+функцию|можно\s+добавить)\b'

  technical_problem:
    - '\b(?:bug|error|issue|problem|broken|fails|failed|not\s+working|doesn\x27t\s+work|reject(?:ed|s|ing)?|exception|traceback)\b'
    - '\b(?:errcode|error\s+code|stack\s+trace|api\s+returns|returns\s+(?:an?\s+)?error)\b'
    - '\b(?:ошибк\w*|проблем\w*|не\s+работает|слом\w*|отклон\w*|исключен\w*)\b'

  job_aggregator:
    - '\b(?:top[- ]paying\s+projects|jobs\s+this\s+week|job\s+of\s+the\s+day|daily\s+jobs|weekly\s+jobs)\b'
    - '\b(?:apply\s+(?:here|below)|see\s+more\s+(?:jobs|vacancies)|our\s+other\s+communities)\b'
    - '\b(?:\d+\s+—\s+.*\b(?:hiring|developer|designer|manager)\b){2,}\b'

  budget_context:
    - '\bbudget\b'
    - '\bcompensation\b'
    - '\bpayment\b'
    - '\bоплата\b'
    - '\bбюджет\b'
    - '\bстоимость\b'
    - '\bцена\b'

  urgency:
    - '\burgent\b'
    - '\basap\b'
    - '\bimmediately\b'
    - '\burgently\b'
    - '\bсрочно\b'
    - '\bкак\s+можно\s+скорее\b'
