thresholds:
  high: 75
  medium: 50

# These weights describe relevance. They do NOT independently create a commercial lead.
categories:
  customer_intent: 0
  trading_bot: 20
  exchange_api: 16
  execution: 20
  strategy_automation: 18
  arbitrage: 20
  copy_trading: 18
  solana_dex: 18
  quant_ml: 20
  urgency: 8
  python: 5
  negative_promotion: -60

terms:
  trading_bot:
    - trading bot
    - crypto bot
    - bybit bot
    - binance bot
    - bitget bot
    - okx bot
    - telegram trading bot
    - trading bot developer
    - grid bot
    - dca bot
    - scalping bot
    - торговый бот
    - торгового бота
    - бот для bybit
    - бот для binance
    - бот для bitget
    - бот для okx
    - бот для фьючерсов

  exchange_api:
    - exchange api
    - api trading
    - binance api
    - bybit api
    - bitget api
    - okx api
    - python developer binance api
    - python developer bybit api
    - api issue
    - api error
    - websocket issue
    - websocket error
    - rest api
    - ошибка api
    - проблема api
    - интеграция api
    - api биржи
    - торговый api
    - ошибка 170140

  execution:
    - order execution
    - execution engine
    - trading execution
    - execution system
    - partial fill
    - partial fills
    - order management
    - order rejected
    - order rejection
    - slippage
    - latency
    - исполнение ордеров
    - частичное исполнение
    - система исполнения
    - ордер отклонен

  strategy_automation:
    - grid bot
    - dca bot
    - scalping bot
    - automation
    - automated trading
    - automated strategy
    - trading strategy
    - strategy implementation
    - strategy automation
    - автоматизация торговли
    - автоматизация стратегии

  arbitrage:
    - arbitrage bot
    - funding arbitrage
    - cross exchange arbitrage
    - basis trading
    - market making
    - market maker
    - арбитражный бот
    - фондовый арбитраж
    - маркет-мейкинг

  copy_trading:
    - copy trading
    - copy-trading bot
    - wallet copy trading
    - trade copier
    - telegram copy trading
    - бот для копитрейдинга
    - копитрейдинг

  solana_dex:
    - solana trading bot
    - solana bot
    - dex bot
    - sniper bot
    - token sniper
    - jupiter bot
    - raydium bot
    - jito bot
    - mev bot
    - solana
    - jupiter
    - raydium
    - jito
    - dex

  quant_ml:
    - ai trading bot
    - ml trading bot
    - ml engineer
    - machine learning engineer
    - ai engineer
    - quant trading
    - signal filtering
    - machine learning trading
    - quant developer
    - quantitative developer
    - quantitative engineer
    - quant researcher
    - algorithmic trading
    - algorithmic trading developer
    - trading infrastructure
    - execution infrastructure
    - алготрейдинг
    - квант
    - квантовый разработчик

  urgency:
    - urgent
    - asap
    - immediately
    - urgently
    - срочно
    - как можно скорее

  python:
    - python
    - python developer
    - pybit
    - ccxt

patterns:
  # Commercial means the person is actually asking someone to perform work,
  # buy/commission a bot, or join on a contract. Technical relevance alone is insufficient.
  commercial_request:
    - '\b(?:i|we)\s+(?:need|want|am looking for|are looking for)\b.{0,140}\b(?:developer|programmer|engineer|coder|freelancer|contractor|someone|person)\b'
    - '\b(?:need|want|looking for)\b.{0,140}\b(?:a\s+)?(?:trading bot|crypto bot|bot|trading system|automation|strategy implementation|algo)\b'
    - '\b(?:buy|purchase|acquire|order|commission)\b.{0,100}\b(?:a\s+)?(?:trading bot|crypto bot|bot)\b'
    - '\b(?:i|we)\s+(?:need|want|would like)\b.{0,140}\b(?:developer|engineer|programmer|someone)\b.{0,120}\b(?:implement|automate|code|convert|build)\b.{0,120}\b(?:my|our|the)?\s*(?:trading\s+)?strategy\b'
    - '\b(?:i|we)\s+(?:have|got)\b.{0,100}\b(?:trading\s+)?strategy\b.{0,100}\b(?:need|want)\b.{0,80}\b(?:developer|engineer|programmer|someone)\b.{0,100}\b(?:implement|automate|code|convert)\b'
    - '\b(?:i|we)\s+(?:need|want|would like)\b.{0,100}\b(?:developer|engineer|programmer|someone)\b.{0,120}\b(?:implement|automate|code|convert)\b.{0,100}\b(?:strategy|trading)\b'
    - '\b(?:can|could)\s+(?:someone|you|anyone)\s+(?:build|develop|create|implement|automate|fix|repair|debug|modify|customi[sz]e)\b.{0,120}\b(?:bot|trading|strategy|api|execution|system|quant)\b'
    - '\b(?:i|we)\s+(?:need|want|would like)\s+(?:help|someone)\s+(?:to\s+)?(?:build|develop|implement|automate|fix|repair|debug|modify|customi[sz]e)\b.{0,120}\b(?:bot|trading|strategy|api|system)\b'
    - '\b(?:hire|hiring|looking to hire|contract|contractor|freelance)\b.{0,160}\b(?:developer|engineer|programmer|quant|trading|ml|machine learning|ai|artificial intelligence)\b'
    - '\b(?:нужен|нужна|ищу|ищем)\b.{0,140}\b(?:разработчик|программист|инженер|квант|фрилансер|подрядчик|человек)\b.{0,120}\b(?:бот|трейдинг|стратег|алготрейдинг|систем|api|бирж)\b'
    - '\b(?:нужно|хочу|хотим|ищем)\b.{0,120}\b(?:сделать|разработать|реализовать|автоматизировать|починить|исправить|доработать)\b.{0,120}\b(?:бот|торгов|стратег|api|систем)\b'

  bot_purchase_request:
    - '\b(?:buy|purchase|acquire|order|commission)\b.{0,100}\b(?:trading bot|crypto bot|bot)\b'
    - '\b(?:looking for|need|want)\b.{0,100}\b(?:a|an|the)?\s*(?:trading bot|crypto bot|bot)\b.{0,100}\b(?:for sale|to buy|commercial|custom)\b'
    - '\b(?:купить|заказать|приобрести)\b.{0,100}\b(?:торгов(?:ый|ого)\s+бот|бот)\b'

  bot_repair_request:
    - '\b(?:fix|repair|debug|troubleshoot)\b.{0,160}\b(?:my|our|the)\s+(?:trading\s+)?bot\b'
    - '\b(?:need|looking for|want)\b.{0,100}\b(?:someone|developer|engineer|programmer)\b.{0,100}\b(?:fix|repair|debug|troubleshoot)\b.{0,120}\b(?:bot|trading|execution|api)\b'
    - '\b(?:my|our)\s+(?:trading\s+)?bot\b.{0,120}\b(?:fix|repair|debug|broken|bug|error|not working|doesn\x27t work|fails)\b'
    - '\b(?:need|looking for|want)\b.{0,100}\b(?:someone|developer|engineer|programmer)\b.{0,80}\b(?:fix|repair|debug|troubleshoot)\b.{0,100}\b(?:bot|trading)\b'
    - '\b(?:починить|исправить|дебажить|отладить)\b.{0,120}\b(?:мой|наш)?\s*(?:торговый\s+)?бот\b'
    - '\b(?:мой|наш)\s*(?:торговый\s+)?бот\b.{0,120}\b(?:сломался|не\s+работает|ошибка|проблема)\b.{0,100}\b(?:починить|исправить|доработать|разработчик|программист)\b'

  bot_customization_request:
    - '\b(?:customi[sz]e|modify|adapt|extend)\b.{0,120}\b(?:my|our|the)?\s*(?:dca|grid|trading|crypto)?\s*bot\b'
    - '\b(?:looking for|need|want)\b.{0,100}\b(?:someone|developer|engineer|programmer)\b.{0,100}\b(?:customi[sz]e|modify|adapt|extend)\b.{0,100}\b(?:bot|trading automation)\b'
    - '\b(?:need|looking for|want)\b.{0,100}\b(?:customi[sz]e|modify|adapt|extend)\b.{0,100}\b(?:bot|trading automation)\b'
    - '\b(?:доработать|модифицировать|адаптировать|расширить)\b.{0,120}\b(?:торгов(?:ый|ого)\s+бот|dca\s+бот|grid\s+бот|бот)\b'

  strategy_implementation_request:
    - '\b(?:i|we)\s+(?:have|got)\b.{0,100}\b(?:trading\s+)?strategy\b.{0,100}\b(?:need|want)\b.{0,80}\b(?:developer|engineer|programmer|someone)\b.{0,100}\b(?:implement|automate|code|convert|build)\b'
    - '\b(?:implement|code|automate|convert|translate)\b.{0,120}\b(?:my|our|the)?\s*(?:trading\s+)?strategy\b'
    - '\b(?:turn|convert)\b.{0,80}\b(?:strategy|idea)\b.{0,100}\b(?:into|to)\b.{0,80}\b(?:bot|automated|automation|code)\b'
    - '\b(?:need|looking for)\b.{0,100}\b(?:someone|developer|engineer)\b.{0,100}\b(?:implement|automate|code|convert)\b.{0,100}\b(?:strategy|trading strategy)\b'
    - '\b(?:реализовать|автоматизировать|перевести|закодировать)\b.{0,120}\b(?:торговую\s+стратегию|стратегию|торговлю)\b'
    - '\b(?:есть|имею)\b.{0,100}\bстратеги\w*\b.{0,120}\b(?:реализовать|автоматизировать|бот|разработчик)\b'

  trading_system_hiring_request:
    - '\b(?:hire|hiring|looking to hire|need|looking for)\b.{0,160}\b(?:trading system|trading infrastructure|execution|algo(?:rithmic)? trading)\b.{0,100}\b(?:developer|engineer|programmer)\b'
    - '\b(?:нужен|ищем|нанимаем)\b.{0,140}\b(?:разработчик|инженер)\b.{0,140}\b(?:торгов(?:ой|ую)\s+систем|исполнен|алготрейдинг|торгов(?:ой|ую)\s+инфраструктур)\b'

  quant_hiring_request:
    - '\b(?:hire|hiring|looking to hire|need|looking for)\b.{0,160}\b(?:quant|quantitative|quant researcher|quant developer)\b.{0,80}\b(?:contract|contractor|freelance|part-time)?\b'
    - '\b(?:нужен|ищем|нанимаем)\b.{0,140}\b(?:квант|quant|количественн\w+\s+аналитик|квантовый\s+разработчик)\b'

  ml_ai_hiring_request:
    - '\b(?:hire|hiring|looking to hire|need|looking for)\b.{0,160}\b(?:ml|machine learning|ai|artificial intelligence)\b.{0,100}\b(?:engineer|developer|scientist|programmer)\b'
    - '\b(?:нужен|ищем|нанимаем)\b.{0,140}\b(?:ml|machine learning|ai|искусственн\w+\s+интеллект)\b.{0,100}\b(?:инженер|разработчик|специалист)\b'

  contract_hiring:
    - '\b(?:hire|hiring|looking to hire|need|looking for)\b.{0,120}\b(?:contract|contractor|freelance|freelancer|consultant|consulting|part-time)\b'
    - '\b(?:contract|contractor|freelance|freelancer|consultant|part-time)\b.{0,120}\b(?:developer|engineer|programmer|quant|ml|ai|trading)\b'
    - '\b(?:нанимаем|нанять|ищем|нужен|ищу)\b.{0,120}\b(?:контракт|подряд|подрядчик|фриланс|консалтинг|частичн\w+\s+занятость)\b'

  service_provider:
    - '\b(?:i|we)\s+(?:can|will)\s+(?:build|develop|fix|create|help)\b.{0,120}\b(?:bot|trading|web3|solana|crypto)\b'
    - '\b(?:i|we)\s+(?:develop|build|offer|provide)\b.{0,120}\b(?:bot|trading|web3|solana|crypto)\b'
    - '\bfeel\s+free\s+to\s+dm\s+me\b'
    - '\bdm\s+me\s+for\s+(?:your|a)\s+project\b'
    - '\bhire\s+me\b'
    - '\bavailable\s+for\s+(?:work|projects|hire)\b'
    - '\bя\s+могу\s+(?:сделать|разработать|починить|помочь)\b'
    - '\bобращайтесь\s+в\s+личку\b'
    - '\bпишите\s+в\s+лс\b'

  job_seeker:
    - '#(?:ищу_работу|open_to_work|looking_for_work)'
    - '\blooking\s+for\s+(?:work|a\s+job|a\s+position)\b'
    - '\b(?:cv|resume)\b'
    - '\bavailability\s*:\s*(?:remote|full-time|part-time|contract)\b'
    - '\bищу\s+работу\b'
    - '\bрезюме\b'
    - '\bготов\s+к\s+работе\b'

  platform_support:
    - '\b(?:reactivat|suspend|appeal|verify|kyc|withdraw|deposit|transfer funds|account restricted|account locked)\w*\b'
    - '\b(?:help me|please help|can you help)\b.{0,60}\b(?:account|subaccount|uid|verification|suspension|withdraw|deposit)\b'
    - '\b(?:check my account|reactivate my account|unblock my account)\b'
    - '\b(?:why|how)\b.{0,180}\b(?:api|endpoint|order|bybit|binance|bitget|okx|bot|dca|grid)\b.{0,120}\b(?:support|supported|allow|permission|restriction|reject|rejecting|work|working|limit|guide|clarif|why)\w*\b'
    - '\b(?:why|how)\b.{0,180}\b(?:reject(?:ed|s|ing)?|error|issue|problem|not\s+working|doesn\x27t\s+work)\b.{0,140}\b(?:api|order|bot|trading)\b'
    - '\b(?:помогите|помоги)\b.{0,80}\b(?:аккаунт|субаккаунт|верификац|блокиров|вывод|пополн)\w*\b'
    - '\b(?:подскажите|объясните|почему|как)\b.{0,160}\b(?:api|endpoint|бирж|аккаунт|ордер)\b'

  technical_problem:
    - '\b(?:bug|error|issue|problem|broken|fails|failed|not working|doesn\x27t work|reject(?:ed|s|ing)?|exception)\b'
    - '\b(?:errcode|error code|stack trace|traceback|api\s+returns|returns\s+(?:an?\s+)?error)\b'
    - '\b(?:ошибк\w*|проблем\w*|не\s+работает|слом\w*|отклон\w*|исключен\w*)\b'
    - '\bwhy\s+(?:is|does|are)\b'
    - '\bкак\s+исправить\b'
    - '\b(?:почему|из-за\s+чего)\b.{0,100}\b(?:ошибка|проблем|не\s+работ|отклон)\w*\b'
